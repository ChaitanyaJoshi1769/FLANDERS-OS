{
  "name": "@flanders/api",
  "version": "1.0.0",
  "description": "FLANDERS OS API - Enterprise industrial operating system backend",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "migrate": "typeorm migration:run -d dist/database/datasource",
    "migrate:create": "typeorm migration:create",
    "seed": "ts-node src/database/seeds/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/websockets": "^10.3.0",
    "@nestjs/graphql": "^12.1.0",
    "typeorm": "^0.3.19",
    "postgres": "^3.4.4",
    "redis": "^4.6.12",
    "ioredis": "^5.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.2",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "kafka-node": "^5.0.0",
    "amqplib": "^0.10.3",
    "mqtt": "^5.0.1",
    "node-opcua": "^2.29.0",
    "graphql": "^16.8.1",
    "@graphql-tools/schema": "^10.0.3",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/lodash": "^4.14.202",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
